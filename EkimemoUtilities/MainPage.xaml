<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EkimemoUtilities.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="15">
            <Label
                Text="EkimemoUtilities"
                Style="{StaticResource Headline}"
                SemanticProperties.HeadingLevel="Level1" />

            <Label
                Text="for Ichihai1415"
                Style="{StaticResource SubHeadline}"
                SemanticProperties.HeadingLevel="Level2"
                SemanticProperties.Description="This is developed by/for Ichihai1415." />

            <Button x:Name="ToggleOverlayButton"
                Text="Show Overlay"
                Clicked="OnToggleOverlayClicked" 
                TextColor="White"/>

            <Button x:Name="StartTimerButton"
                Text="(Re)Start Timer"
                Clicked="OnStartClicked" 
                TextColor="White"
                BackgroundColor="#512BD4"/>

            <Button x:Name="ToggleLocationButton"
                Text="Start Getting Location" 
                Clicked="OnToggleLocationClicked"
                TextColor="White"/>

            <Border></Border>

            <Label Text="⚙ Settings" FontAttributes="Bold" FontSize="Large"/>
            <VerticalStackLayout Margin="20,0,0,0" Spacing="8">
                <Label Text="Timer Duration:"/>
                <HorizontalStackLayout Margin="20,0,0,0" Spacing="4">

                    <Label x:Name="DurationLabel" Text="---" Margin="0,6,0,0"  FontSize="Large"/>
                    <Label Text="sec" Margin="0,18,0,0" FontSize="Small"/>

                    <Stepper x:Name="DurationStepper"
                    Minimum="1"
                    Maximum="360"
                    Increment="1"
                    ValueChanged="OnDurationChanged" />
                </HorizontalStackLayout>

                <Label Text="Get Location Interval: &#10; (After changed, restart Getting Location!)" />
                <HorizontalStackLayout Margin="20,0,0,0" Spacing="4">
                    <Label x:Name="IntervalLabel" Text="---" Margin="0,6,0,0"  FontSize="Large"/>
                    <Label Text="sec" Margin="0,18,0,0" FontSize="Small"/>
                    <Stepper x:Name="IntervalStepper"
                        Minimum="1"
                        Maximum="300"
                        Increment="1"
                        ValueChanged="OnIntervalChanged" />
                </HorizontalStackLayout>

                <Label Text="GPS Wait Time Before Use an Alternative:&#10; (Alternative: Network-based. If set to 0, it is not used.)"/>
                <HorizontalStackLayout Margin="20,0,0,0" Spacing="4">
                    <Label x:Name="GPSWaitLabel" Text="---" Margin="0,6,0,0"  FontSize="Large"/>
                    <Label Text="sec" Margin="0,18,0,0" FontSize="Small"/>
                    <Stepper x:Name="GPSWaitStepper"
                         Minimum="0"
                         Maximum="60"
                         Increment="0.1"
                         ValueChanged="OnGPSWaitChanged" />
                </HorizontalStackLayout>


                <HorizontalStackLayout>
                    <CheckBox Margin="-10,10,0,-10" x:Name="VibrationCheckBox" IsChecked="True" CheckedChanged="OnVibrationCheckBoxChanged"/>
                    <Label Margin="0,22,0,-10" Text="Enable Vibration">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnVibrationLabelTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                </HorizontalStackLayout>

                <HorizontalStackLayout>
                    <CheckBox Margin="-10,0,0,0"  x:Name="NotificationCheckBox" IsChecked="True" CheckedChanged="OnNotificationCheckBoxChanged"/>
                    <Label Margin="0,12,0,0" Text="Enable Notification">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnNotificationLabelTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                </HorizontalStackLayout>


                <HorizontalStackLayout>
                    <CheckBox Margin="-10,10,0,-10"  x:Name="HideLocationCheckBox" IsChecked="False" CheckedChanged="OnHideLocationCheckBoxChanged"/>
                    <Label Margin="0,22,0,-10" Text="Hide Location (overlay)">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnHideLocationLabelTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                </HorizontalStackLayout>

                <HorizontalStackLayout>
                    <CheckBox Margin="-10,0,0,0"  x:Name="HideTimerCheckBox" IsChecked="False" CheckedChanged="OnHideTimerCheckBoxChanged"/>
                    <Label Margin="0,12,0,0" Text="Hide Timer (overlay)">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnHideTimerLabelTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                </HorizontalStackLayout>

            </VerticalStackLayout>

        </VerticalStackLayout>

    </ScrollView>
</ContentPage>
